{
  "name": "inkbound",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Draw a beast with one stroke. Its shape becomes its stats. Survive 60 seconds.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/inline.mjs",
    "build:multi": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
